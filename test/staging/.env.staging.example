# Tier 3 staging config. Copy to test/staging/.env.staging (gitignored) and fill in.
# Everything here is SEPARATE from production — a different bot, a dedicated test
# account, isolated state under state/staging/.

# --- The staging BOT (must be a DIFFERENT bot than production) --------------------
# Create one with @BotFather, get its token. The bridge runs as this bot.
STAGING_BOT_TOKEN=
# The staging bot's @username (no leading @ is fine), so the driver can DM it.
STAGING_BOT_USERNAME=my_staging_bot

# --- The TEST USER ACCOUNT that drives the bot -----------------------------------
# A DEDICATED Telegram account (NOT your main one) — automation carries a ban risk.
# 1) Get api_id/api_hash at https://my.telegram.org/apps (same pair local-api.sh uses).
# 2) Run:  python3 test/staging/gen_session.py   → prints TEST_ACCOUNT_USER_ID + TG_TEST_SESSION.
TG_API_ID=
TG_API_HASH=
TG_TEST_SESSION=
# The test account's numeric user id (printed by gen_session.py). The staging bridge
# only answers this id (it becomes TG_ALLOWED_USERS).
TEST_ACCOUNT_USER_ID=

# --- Options ---------------------------------------------------------------------
# Seconds to wait for each reply before failing a case.
STAGING_REPLY_TIMEOUT=60
# Leave unset for deterministic runs (CLAUDE_BIN → test/claude-stub.ts). Set to 1 to
# test against the REAL claude CLI (looser, non-hermetic smoke).
# STAGING_REAL_CLAUDE=1
# Override the fake CLI if you want (defaults to the repo's test/claude-stub.ts).
# STAGING_CLAUDE_BIN=/absolute/path/to/claude
