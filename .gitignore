node_modules/
.env
state/
*.log
# Per-topic file transfer dirs — these hold files the USER uploaded and files
# staged to send back. They must never land in the repo (this one is public).
inbox/
outbox/

# downloaded neural voice model (voice/setup.sh --piper)
voice/piper/

# Kokoro model files (voice/setup.sh --kokoro)
voice/kokoro/*.onnx
voice/kokoro/*.bin

# live voice server log
live/live.log

# Tier 3 staging secrets: a second bot token + a test-account StringSession, which
# is account-takeover-grade. Templates (*.example) stay tracked; real files never.
.env.staging
*.session
test/staging/session.txt

# python bytecode
__pycache__/
*.pyc

# python venvs
.venv/
# isolated pip --target dir (alt to venv)
test/staging/.deps/
